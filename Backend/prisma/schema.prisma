generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String                          // owner/contact name
  email         String    @unique
  phone         String?
  password      String
  role          String    @default("consumer") // consumer | restaurant | ngo

  // Restaurant-specific
  businessName  String?
  cuisineType   String?
  businessImage String?   // URL/path to uploaded business image

  // NGO-specific
  ngoRegNumber  String?
  contactPerson String?

  // Location (all roles)
  address       String?
  city          String?
  state         String?
  pincode       String?

  // Auth internals
  resetOtp      String?
  otpExpiry     DateTime?
  createdAt     DateTime  @default(now())

  // Relations
  listings      FoodListing[]
}

model FoodListing {
  id              Int       @id @default(autoincrement())
  restaurantId    Int
  restaurant      User      @relation(fields: [restaurantId], references: [id])

  // Basic Info
  name            String
  category        String
  subCategory     String?
  description     String?
  tags            String?

  // Images (JSON array of URLs)
  images          String    @default("[]")

  // Quantity & Pricing
  quantity        Float
  unit            String    @default("kg")
  originalPrice   Float
  discountedPrice Float
  minOrder        Float?

  // Availability
  expiryDate      String
  expiryTime      String
  availableFrom   DateTime?
  availableUntil  DateTime?

  // Details
  ingredients     String?
  allergens       String    @default("[]")
  dietary         String    @default("[]")
  storage         String?

  // Logistics
  pickup          Boolean   @default(true)
  delivery        Boolean   @default(false)
  deliveryRadius  Float?
  packaging       String?
  instructions    String?

  // Status
  status          String    @default("active") // active | draft | expired

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
